prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 8.27.100
Requires: libswscale >= 6.5.100, libpostproc >= 56.4.100, libavformat >= 59.17.102, libavcodec >= 59.21.100, libswresample >= 4.4.100, libavutil >= 57.21.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavfilter -pthread -lm -latomic
Libs.private: 
Cflags: -I${includedir}
