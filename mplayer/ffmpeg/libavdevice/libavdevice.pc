prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 59.5.100
Requires: libavfilter >= 8.27.100, libswscale >= 6.5.100, libpostproc >= 56.4.100, libavformat >= 59.17.102, libavcodec >= 59.21.100, libswresample >= 4.4.100, libavutil >= 57.21.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavdevice -lm -latomic -lXv -lX11 -lXext
Libs.private: 
Cflags: -I${includedir}
